{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-noop",
      "displayName": "Native (noop backend)",
      "description": "Default development build. No CPU execution, but exercises the full core/emulator/HLE/layout wiring (see CLAUDE.md).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-noop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPU_BACKEND": "noop"
      }
    },
    {
      "name": "native-interpreter",
      "displayName": "Native (interpreter backend)",
      "description": "Runs guest ARM64 code on the interpreter (\u00a78, \u00a725 Phase 2) - what the web build ships.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-interpreter",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPU_BACKEND": "interpreter"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "description": "WASM build per docs/DESIGN.md \u00a724. Requires $EMSDK to be set - run emsdk_env.{sh,ps1,bat} first.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPU_BACKEND": "interpreter"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native, interpreter backend, optimized (voland-cli for real use)",
      "description": "Release build of the interpreter backend: what you run real homebrew with natively.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPU_BACKEND": "interpreter"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-noop",
      "configurePreset": "native-noop"
    },
    {
      "name": "native-interpreter",
      "configurePreset": "native-interpreter"
    },
    {
      "name": "web",
      "configurePreset": "web"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-noop",
      "configurePreset": "native-noop",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "native-interpreter",
      "configurePreset": "native-interpreter",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}
